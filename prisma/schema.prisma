generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Tenant do sistema. Cada igreja enxerga apenas os próprios eventos, as
/// pessoas ligadas a eles e as próprias notícias — o recorte é aplicado em
/// `src/auth/tenant.ts`. Só o super admin atravessa todas.
model Church {
  id     String           @id @default(uuid())
  name   String
  users  UserChurchRole[]
  events Event[]
  news   News[]
  /// Por onde esta igreja cobra. Ver `PaymentProviderConfig`: cada uma tem a
  /// própria conta no gateway, e o dinheiro do evento dela cai lá.
  gateways PaymentProviderConfig[]
  /// A sessão de WhatsApp desta igreja. Cada uma pareia o próprio número —
  /// ver `WhatsappAuth`.
  whatsapp WhatsappAuth[]

  /// O módulo de cobrança online está ligado para esta igreja?
  ///
  /// Substitui as duas variáveis de ambiente que faziam isso antes
  /// (`PAGBANK_PAYMENT_ENABLED` no servidor, `VITE_MODULE_PAYMENT` na tela),
  /// que eram globais: desligar uma delas tirava a cobrança de todas as
  /// igrejas ao mesmo tempo, e não havia como uma cobrar e a outra não.
  ///
  /// Desligado, o sistema não abre checkout, a reconciliação pula as cobranças
  /// desta igreja e a tela esconde tudo que fala de pagamento. Quem liga e
  /// desliga é dev ou super admin — é decisão de plataforma, não de quem
  /// administra a igreja, do mesmo jeito que a variável de ambiente era.
  ///
  /// Nasce ligado para as igrejas que já existem: era esse o valor da variável
  /// global, e mudar o padrão na migração tiraria a cobrança de quem já cobra.
  /// Igreja sem gateway cadastrado continua sem cobrar de qualquer forma.
  modulePayment Boolean @default(true)

  @@map("churches")
}

/// Vínculo de painel: qual perfil a pessoa tem em qual igreja.
///
/// É aqui que mora a permissão de quem administra. A mesma pessoa pode ser
/// admin de uma igreja e financeiro de outra, e cada linha vale só para a sua
/// igreja — o perfil não vaza de uma para a outra.
///
/// Fora daqui existem só dois perfis, e nenhum deles é de igreja: super admin
/// (atravessa todas) e usuário comum (não pertence a nenhuma).
model UserChurchRole {
  userId    String
  churchId  String
  /// 2 = admin, 3 = financeiro. Um perfil por igreja: admin já faz o que o
  /// financeiro faz, então as duas linhas na mesma igreja não fariam sentido.
  role      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  church    Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@id([userId, churchId])
  @@index([churchId])
  @@map("user_church_roles")
}

model User {
  id                 String            @id @default(uuid())
  email              String
  fullName           String
  cpf                String            @unique
  birthday           DateTime
  cellphone          String
  religion           String?
  notes              String?
  createdAt          DateTime          @default(now())
  updateAt           DateTime          @updatedAt
  city               String
  diabetes           Boolean
  emergencyContact   String?
  hypertensive       Boolean
  indicatedBy        String?
  leadershipPosition String?
  profession         String
  profilePhotoUrl    String?
  /// Perfil efetivo: 1 super admin, 5 usuário comum, ou o mais alto dos
  /// vínculos em `churchRoles`. É o que os guards de rota leem para saber se a
  /// pessoa pode chegar na rota — qual igreja ela alcança vem dos vínculos.
  /// Escrito junto deles, na mesma transação, por `UserService`.
  role               Int               @default(5)
  state              String
  worker             Boolean
  registrationNumber Int               @unique @default(autoincrement())
  neighborhood       String
  badgeName          String?
  password           String            @default("$2b$10$QGF/lucztAy.bqQFEQcSOOjP3fGMZfSsCIl4t.dfFo15Hh0v/C8xW")
  /// Vínculos de painel: em qual igreja a pessoa é admin e em qual é
  /// financeiro. É daqui que sai QUAL igreja ela alcança.
  churchRoles        UserChurchRole[]
  bedrooms           BedroomsOnUsers[]
  events             EventOnUsers[]
  TeamOnUsers        TeamOnUsers[]
  waitlists          Waitlist[]
  checkins           Checkin[]
  news               News[]
  tokens             UserToken[]
  loginAttempts      LoginAttempt[]

  @@map("users")
}

/// Token de uso único e vida curta para fluxos que acontecem **fora** da sessão
/// autenticada — hoje só a redefinição de senha. A linha existe apenas enquanto
/// o usuário está no meio do processo: ao concluir (ou estourar tentativas) ela
/// é apagada, então a tabela vive praticamente vazia.
///
/// Nada aqui é guardado em claro. O código de 8 dígitos vai só no e-mail, e o
/// que fica no banco é o hash — um vazamento do banco não entrega o fluxo de
/// recuperação de ninguém.
model UserToken {
  id         String   @id @default(uuid())
  userId     String
  /// 0 = redefinição de senha. Inteiro em vez de enum para um fluxo novo
  /// (confirmação de e-mail, convite) entrar sem migração de tipo.
  type       Int
  /// bcrypt do código de 8 dígitos. bcrypt e não SHA porque 10^8 combinações
  /// são varridas em segundos com hash rápido caso o banco vaze.
  codeHash   String
  /// SHA-256 do ticket entregue quando o código confere. Aqui o SHA basta: o
  /// ticket tem 256 bits de entropia, não há o que adivinhar por força bruta.
  ticketHash String?  @unique
  /// Tentativas erradas de código. Ao chegar em 5 a linha é destruída.
  attempts   Int      @default(0)
  /// 1h enquanto vale o código; encurta para 15min quando vira ticket.
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Atende a busca do token ativo do usuário e o descarte por vencimento
  @@index([userId, type])
  @@index([expiresAt])
  @@map("user_tokens")
}

/// Tentativa de entrada no sistema: uma linha por `POST /auth/login`, dando
/// certo ou não.
///
/// Antes desta tabela o sistema não guardava **nada** sobre acesso — nem
/// último login, nem tentativa. Dava para saber quem alterou um quarto, mas
/// não quem entrou, e menos ainda quantas vezes alguém errou a senha na porta.
///
/// Guarda o documento digitado mesmo quando ele não é de ninguém: é
/// exatamente isso que mostra alguém varrendo CPFs. Senha nunca é gravada, em
/// claro nem em hash.
model LoginAttempt {
  id        String              @id @default(uuid())
  /// O documento digitado, como veio. Fica preenchido também nas falhas.
  document  String
  /// Nulo quando o documento não bate com ninguém
  userId    String?
  user      User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  success   Boolean
  /// Só nas falhas: separa senha errada de documento inexistente
  reason    LoginFailureReason?
  ip        String?
  userAgent String?
  createdAt DateTime            @default(now())

  /// Atende o gráfico do painel, que varre uma janela de dias
  @@index([createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("login_attempts")
}

/// Por que a entrada foi recusada. Separar as duas importa: senha errada em
/// massa numa conta é ataque a ela; documento inexistente em massa é varredura.
enum LoginFailureReason {
  /// Não existe usuário com o documento digitado
  USER_NOT_FOUND
  /// O usuário existe e a senha não confere
  WRONG_PASSWORD
}

model Event {
  id         String         @id @default(uuid())
  name       String
  startDate  DateTime
  endDate    DateTime
  createdAt  DateTime       @default(now())
  updateAt   DateTime       @updatedAt
  /// Coluna antiga, preservada porque os eventos já existem em produção.
  /// `@ignore` mantém ela no banco e fora do Prisma Client: nada no código lê
  /// ou escreve esse campo — quem manda na visibilidade agora é `status`.
  isActive   Boolean        @default(false) @ignore
  status     EventStatus    @default(ACTIVE)
  groupLink  String? // link do grupo do evento (Inativo)
  type       EventType      @default(CURSILHO)
  data       Json?
  churchId   String
  church     Church         @relation(fields: [churchId], references: [id], onDelete: Cascade)
  users      EventOnUsers[]
  bedrooms   Bedrooms[]
  groupRoles GroupRoles[]
  Team       Team[]
  waitlist   Waitlist[]
  checkins   Checkin[]
  news       News[]

  @@index([churchId])
  @@map("events")
}

model EventOnUsers {
  userId            String
  eventId           String
  createdAt         DateTime                        @default(now())
  updatedAt         DateTime                        @updatedAt
  event             Event                           @relation(fields: [eventId], references: [id])
  user              User                            @relation(fields: [userId], references: [id])
  rolesRegistration EventOnUsersRolesRegistration[] @relation("EventOnUsersRoles")

  @@id([userId, eventId])
  @@index([eventId])
}

model EventOnUsersRolesRegistration {
  userId             String
  eventId            String
  roleRegistrationId String
  discountId         String?
  discount           Discounts?        @relation(fields: [discountId], references: [id])
  role               RolesRegistration @relation(fields: [roleRegistrationId], references: [id], onDelete: Cascade)
  eventOnUsers       EventOnUsers      @relation("EventOnUsersRoles", fields: [userId, eventId], references: [userId, eventId], onDelete: Cascade)
  payment            Payment?

  @@id([userId, eventId, roleRegistrationId])
  @@index([eventId])
  @@index([roleRegistrationId])
  @@index([discountId])
}

model GroupRoles {
  id       String              @id @default(uuid())
  name     String
  capacity Int?
  eventId  String
  event    Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  roles    RolesRegistration[]
  link     String?
  news     NewsOnGroupRoles[]

  @@index([eventId])
  @@map("group_roles")
}

model RolesRegistration {
  id           String                          @id @default(uuid())
  price        Float
  description  String
  groupId      String
  EventOnUsers EventOnUsersRolesRegistration[]
  group        GroupRoles                      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  Waitlist     Waitlist[]

  @@index([groupId])
  @@map("roles_registration_types")
}

model Discounts {
  id          String                          @id @default(uuid())
  percentage  Float
  description String
  createdAt   DateTime                        @default(now())
  updatedAt   DateTime                        @updatedAt
  registers   EventOnUsersRolesRegistration[]

  @@map("discounts")
}

model Payment {
  id                 String                         @id @default(uuid())
  method             PaymentMethod
  status             PaymentStatus
  receivedFrom       PaymentReceived                @default(SYSTEM)
  amount             Float
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt
  eventId            String?
  roleRegistrationId String?
  userId             String?
  payload            Json?
  checkouts          PaymentCheckout[]
  eventUserRole      EventOnUsersRolesRegistration? @relation(fields: [userId, eventId, roleRegistrationId], references: [userId, eventId, roleRegistrationId], onDelete: Cascade)

  @@unique([userId, eventId, roleRegistrationId])
  @@index([eventId])
  @@map("payments")
}

model PaymentCheckout {
  id          String         @id @default(uuid())
  paymentId   String
  checkoutId  String
  referenceId String
  status      CheckoutStatus
  amount      Float
  link        String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  payment     Payment        @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  /// Qual casa gerou este checkout.
  ///
  /// Com um gateway só a pergunta não existia. Com quatro, o `referenceId`
  /// sozinho não diz a quem perguntar — e perguntar à casa errada devolve
  /// "não existe": a reconciliação desistiria da cobrança e um pagamento pago
  /// ficaria em WAITING para sempre.
  ///
  /// `PAGBANK` como padrão porque é o que existe em produção: toda linha
  /// anterior a esta coluna nasceu lá.
  provider PaymentProvider @default(PAGBANK)

  /// A credencial usada. Fica nula quando ela é removida depois — o histórico
  /// do checkout não pode sumir junto com a credencial que o gerou.
  configId String?

  /// Quanto foi pedido à casa, em centavos e já com o desconto abatido.
  ///
  /// `amount` guarda a soma dos ingressos em reais, sem desconto: serve para o
  /// relatório e não para conferir o que voltou pago. Esta coluna é a outra
  /// metade da baixa — sem ela, "a casa disse que pagou" é a única prova de
  /// que o dinheiro entrou, e numa das integrações essa frase é barata de
  /// forjar (ver `conferirValorPago`).
  ///
  /// Nula nos checkouts anteriores a esta coluna: não há como reconstruir o
  /// valor enviado, e recusar o que é antigo derrubaria pagamento em curso.
  chargedAmountCents Int?

  @@index([paymentId])
  /// Atende a rota de webhook e a reconciliação, que chegam pelo par
  /// referência + casa
  @@index([provider, referenceId])
  @@map("payment_checkouts")
}

/// Como cada igreja cobra: qual casa processa o dinheiro e com que credencial.
///
/// Até aqui havia um token só, no `.env`, valendo para o sistema inteiro —
/// duas igrejas no mesmo servidor cobravam na conta da primeira, e trocar de
/// gateway era redeploy. Aqui a linha é por igreja e por casa: a igreja
/// escolhe onde cobrar, coloca a credencial dela, e o dinheiro cai na conta
/// dela.
///
/// Nenhuma credencial fica em claro. `credentials` guarda um envelope
/// AES-256-GCM (ver `SecretCryptoService`) selado com `churchId` e `provider`
/// como dado autenticado: um envelope copiado para a linha de outra igreja não
/// abre, então nem quem escreve no banco consegue desviar a cobrança.
model PaymentProviderConfig {
  id       String          @id @default(uuid())
  churchId String
  provider PaymentProvider

  /// Sandbox e produção têm URL e credencial diferentes nas quatro casas
  mode PaymentProviderMode @default(PRODUCTION)

  /// Desliga a cobrança sem apagar a credencial — é o que se usa quando a casa
  /// está fora do ar e a igreja precisa voltar a receber pela mão.
  enabled Boolean @default(false)

  /// A casa que recebe os novos checkouts desta igreja. Uma só por igreja; a
  /// troca acontece em transação, em `PaymentProviderService`.
  isDefault Boolean @default(false)

  /// Envelope cifrado com as credenciais. Não sai daqui em claro em lugar
  /// nenhum: a API devolve `credentialsHint`, e a auditoria redige o campo.
  credentials String

  /// Qual chave do `.env` selou o envelope. Existe para a rotação acontecer
  /// sem parar o sistema: a nova sela, a antiga ainda abre.
  keyVersion Int @default(1)

  /// O bastante para a pessoa reconhecer o que cadastrou ("••••4F2A") e de
  /// menos para usar. É o que a tela de configurações mostra.
  credentialsHint Json?

  /// SHA-256 do segredo que vai na URL de notificação desta configuração.
  ///
  /// O segredo em claro existe em dois lugares: na tela, no instante em que é
  /// gerado, e no cadastro do provedor. Não aqui — quem levar o banco não
  /// consegue forjar um "pagamento aprovado" na URL de ninguém.
  webhookSecretHash String @unique

  /// Últimos caracteres do segredo, para conferir a URL cadastrada na casa
  webhookSecretHint String?

  /// Quando uma notificação desta configuração foi aceita pela última vez.
  /// Alimenta o aviso de "credencial salva, mas nunca chegou retorno" — o
  /// sintoma de URL cadastrada errada do lado de lá.
  lastWebhookAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  updatedById String?

  church Church @relation(fields: [churchId], references: [id], onDelete: Cascade)

  /// Uma linha por casa em cada igreja: a mesma cadastrada duas vezes só cria
  /// dúvida sobre qual credencial está valendo
  @@unique([churchId, provider])
  @@index([churchId])
  @@map("payment_provider_configs")
}

model Waitlist {
  id                 String             @id @default(uuid())
  userId             String
  eventId            String
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  roleRegistrationId String?
  event              Event              @relation(fields: [eventId], references: [id])
  rolesRegistration  RolesRegistration? @relation(fields: [roleRegistrationId], references: [id])
  user               User               @relation(fields: [userId], references: [id])

  @@unique([userId, eventId, roleRegistrationId])
  @@index([eventId])
  @@index([roleRegistrationId])
  @@map("waitlist")
}

model Bedrooms {
  id        String            @id @default(uuid())
  note      String?
  eventId   String
  capacity  Int?
  name      String            @default("Quarto sem nome")
  tag       String[]
  /// Nomes de grupos de inscrição que podem ocupar o quarto. Vazio = quarto
  /// aberto, qualquer inscrito entra. Preenchido = restrito a esses grupos,
  /// tanto na alocação automática do check-in quanto na montagem manual.
  groupTags String[]          @default([])
  users     BedroomsOnUsers[]
  event     Event             @relation(fields: [eventId], references: [id])

  @@index([eventId])
  @@map("bedrooms")
}

model BedroomsOnUsers {
  userId     String
  bedroomsId String
  bedrooms   Bedrooms @relation(fields: [bedroomsId], references: [id])
  user       User     @relation(fields: [userId], references: [id])

  @@id([userId, bedroomsId])
  @@index([bedroomsId])
}

model Team {
  id       String        @id @default(uuid())
  name     String
  eventId  String
  capacity Int?
  note     String?
  users    TeamOnUsers[]
  event    Event         @relation(fields: [eventId], references: [id])

  @@index([eventId])
  @@map("teams")
}

model TeamOnUsers {
  userId String
  teamId String
  role   TeamRole @default(MEMBER)
  team   Team     @relation(fields: [teamId], references: [id])
  user   User     @relation(fields: [userId], references: [id])

  @@id([userId, teamId])
  @@index([teamId])
}

/// Check-in presencial do evento, em tabela própria para não alterar `EventOnUsers`.
/// Uma linha por participante/evento, criada quando ele chega na recepção.
/// A ausência de linha equivale a `PENDING` (ainda não chegou).
model Checkin {
  id      String        @id @default(uuid())
  userId  String
  eventId String
  status  CheckinStatus @default(PENDING)

  /// Etapa 1 — recepção reconheceu o participante e entregou o crachá
  badgeDeliveredAt   DateTime?
  badgeDeliveredById String?
  /// Etapa 2 — operador do posto de foto chamou este participante da fila
  calledAt           DateTime?
  calledById         String?
  /// Etapa 3 — foto tirada e dados conferidos
  doneAt             DateTime?
  doneById           String?

  notes         String?
  /// Quarto que a entrega do crachá alocou sozinha. Guardado para o "reverter
  /// entrega" liberar a vaga — e só ela: quarto definido à mão não tem essa
  /// marca e fica onde está.
  autoBedroomId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  event Event @relation(fields: [eventId], references: [id])

  /// Impede duas linhas de check-in para a mesma inscrição
  @@unique([userId, eventId])
  /// Atende a fila (status QUEUED/IN_PROGRESS) e os contadores por status
  @@index([eventId, status])
  @@map("checkins")
}

model Log {
  id       String  @id @default(uuid())
  model    String // nome da tabela (ex: User, Order, Map)
  action   String // create | update | delete
  entityId String? // id do registro afetado
  before   Json? // estado anterior
  after    Json? // estado posterior
  userId   String? // quem executou a ação

  /// Amarra as várias escritas de uma mesma requisição. Uma ação do painel
  /// costuma tocar em três ou quatro tabelas, e sem isto a tela de atividades
  /// mostraria cada uma como um evento separado.
  requestId String?

  /// O que a pessoa mandou o sistema fazer, no molde da rota:
  /// `POST /events/:idEvent/users/:idUser`. Com os ids fora, duas inscrições
  /// diferentes contam como a mesma operação — é o que dá nome ao grupo e
  /// permite filtrar por "inscrições" em vez de por tabela.
  ///
  /// Nulo no histórico anterior a esta coluna e no que não nasce de uma
  /// requisição HTTP; aí o nome volta a ser deduzido da tabela principal.
  operation String?

  /// Quem a ação atingiu, extraído do snapshot na hora da gravação. É lista
  /// porque um `deleteMany` derruba o vínculo de várias pessoas de uma vez.
  /// Sem esta coluna o filtro por usuário da tela de atividades teria que
  /// abrir o JSON de todas as linhas a cada consulta.
  targetUserIds String[]

  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([requestId])
  @@index([operation, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([targetUserIds(ops: ArrayOps)], type: Gin)
  @@map("logs")
}

/// Trilha do dinheiro, separada de `Log` porque a pergunta é outra.
///
/// `Log` responde "quem mexeu no sistema" e guarda o registro inteiro em JSON.
/// Aqui a pergunta é "o que aconteceu com esta cobrança", e a resposta precisa
/// caber na linha: valor, status, e de onde veio a mudança. Uma consulta por
/// evento ou por pessoa não pode depender de abrir JSON nem de um join que
/// morre quando a inscrição é apagada.
///
/// Uma linha por cobrança afetada, e não por comando: o `updateMany` que a
/// reconciliação dispara mexe em várias, e "o que aconteceu com a minha" é a
/// pergunta que o financeiro faz.
model PaymentLog {
  id String @id @default(uuid())

  /// A cobrança afetada. Sem relação declarada de propósito: apagar a cobrança
  /// não pode levar o histórico junto — é justamente aí que ele importa.
  paymentId String?

  /// Quem deve e por qual evento, copiados na hora da gravação. O join com
  /// `payments` deixa de existir quando a inscrição é cancelada, e é a consulta
  /// por evento que o financeiro mais faz.
  userId  String?
  eventId String?

  /// Tabela e operação do Prisma, para a origem técnica não se perder
  model    String
  action   String
  entityId String?

  /// O dinheiro antes e depois. Nulo quando a operação não mexeu no valor.
  amountBefore Float?
  amountAfter  Float?

  /// Texto e não enum: `Payment` usa `PaymentStatus` e `PaymentCheckout` usa
  /// `CheckoutStatus`, e a mesma coluna guarda os dois.
  statusBefore String?
  statusAfter  String?

  /// De onde veio a mudança — a coluna que o `Log` genérico não tem e que aqui
  /// é a primeira pergunta: foi alguém ou foi a máquina?
  source PaymentLogSource

  /// Quem executou. Nulo no cron e no retorno do PagBank: ali não há pessoa.
  actorId String?

  /// A rota, quando nasceu de uma requisição; o nome da rotina, quando é cron
  operation String?

  /// Amarra as escritas de uma mesma operação, igual em `Log`
  requestId String?

  /// O que mudou campo a campo, para o que não cabe nas colunas acima
  changes Json?

  createdAt DateTime @default(now())

  @@index([paymentId, createdAt(sort: Desc)])
  @@index([eventId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("payment_logs")
}

/// De onde partiu a mudança no dinheiro.
enum PaymentLogSource {
  /// Uma pessoa identificada, agindo pela API
  PANEL
  /// Retorno do PagBank
  WEBHOOK
  /// Rotina automática — hoje, a reconciliação de pagamentos
  CRON
  /// Escrita sem pessoa identificada: a inscrição que gera a cobrança, e o
  /// que roda fora de qualquer requisição
  SYSTEM
}

enum TeamRole {
  MEMBER
  LEADER
}

/// Etapas do check-in presencial. Ver os campos `checkin*` em `EventOnUsers`.
enum CheckinStatus {
  /// Inscrito que ainda não chegou ao evento
  PENDING
  /// Crachá entregue na recepção; aguardando na fila da foto
  QUEUED
  /// Chamado por um operador do posto de foto/conferência
  IN_PROGRESS
  /// Foto tirada e dados conferidos
  DONE
}

enum EventType {
  CURSILHO
  RETIRO
}

/// Estado de publicação do evento, mostrado como "Status do evento" no painel.
enum EventStatus {
  /// Aberto ao público: aparece na área do usuário para qualquer inscrito
  ACTIVE
  /// Desligado: não aparece para ninguém na área do usuário
  INACTIVE
  /// Ensaio antes de abrir ao público: só admin e super admin enxergam
  TEST
}

/// As casas que processam o dinheiro.
///
/// O nome é gravado em `PaymentCheckout.provider` e é a chave que o registry
/// de `src/gateways` usa para escolher o adapter. Acrescentar uma casa é
/// acrescentar um valor aqui e um adapter lá — nada mais no fluxo de cobrança
/// muda.
enum PaymentProvider {
  PAGBANK
  MERCADO_PAGO
  INFINITEPAY
  /// Ton é Stone: o checkout hospedado vem da API do grupo (Pagar.me v5)
  TON
}

/// Ambiente da credencial. Não é preferência de tela: sandbox e produção têm
/// URL, chave e assinatura diferentes nas quatro casas, e o adapter escolhe a
/// base por aqui.
enum PaymentProviderMode {
  SANDBOX
  PRODUCTION
}

enum PaymentReceived {
  SYSTEM
  EXTERNAL
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  CASH
  BOLETO
  OTHER
}

enum PaymentStatus {
  PAID
  IN_ANALYSIS
  DECLINED
  CANCELED
  WAITING
  REFUNDED
}

enum CheckoutStatus {
  ACTIVE
  EXPIRED
  INACTIVE
}

/// Notícia do mural: a secretaria publica e todo inscrito vê no feed de /eventos.
model News {
  id          String             @id @default(uuid())
  title       String
  /// chamada curta usada no feed; o texto inteiro fica em `content`
  summary     String?
  content     String
  imageUrl    String?
  /// rascunho não aparece no feed
  isPublished Boolean            @default(false)
  /// data da primeira publicação — é por ela que o feed ordena
  publishedAt DateTime?
  authorId    String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  /// igreja que publicou. Diz quem administra a notícia — não quem a lê: o
  /// mural é de todo mundo. Nulo quando quem publicou foi o super admin.
  churchId    String?
  church      Church?            @relation(fields: [churchId], references: [id], onDelete: Cascade)
  /// Público do anúncio. Nulo (o padrão) é aviso geral, que aparece para todo
  /// mundo; preenchido restringe o mural a quem está no evento — inscrito ou
  /// na lista de espera.
  eventId     String?
  event       Event?             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  author      User?              @relation(fields: [authorId], references: [id])
  groups      NewsOnGroupRoles[]

  @@index([isPublished, publishedAt])
  @@index([churchId])
  @@index([eventId])
  @@map("news")
}

/// Grupos escolhidos como destino da notícia no WhatsApp. O destino é o grupo
/// de inscrição (`GroupRoles`), porque é nele que mora o link do grupo.
///
/// A linha é o destino e o comprovante ao mesmo tempo: guarda também o
/// resultado do envio, para a tela mostrar o que saiu, o que falhou e por quê —
/// e para o reenvio repetir só o que ficou pendente.
model NewsOnGroupRoles {
  newsId      String
  groupRoleId String
  /// preenchido quando o WhatsApp aceitou a mensagem
  sentAt      DateTime?
  /// motivo da última falha; volta a null quando o envio dá certo
  error       String?
  news        News       @relation(fields: [newsId], references: [id], onDelete: Cascade)
  groupRole   GroupRoles @relation(fields: [groupRoleId], references: [id], onDelete: Cascade)

  @@id([newsId, groupRoleId])
  @@index([groupRoleId])
  @@map("news_on_group_roles")
}

/// Estado da sessão do WhatsApp (Baileys): uma linha por chave — `creds` e as
/// chaves de criptografia do Signal.
///
/// Fica no banco, e não em arquivo, porque o container é recriado a cada deploy:
/// em disco a sessão morreria junto e alguém teria que parear o número de novo
/// toda vez que subisse uma versão.
/// Sessão do WhatsApp, uma por igreja.
///
/// Era uma só para o sistema inteiro, e isso obrigava todas as igrejas a
/// disparar pelo mesmo número: quem parear ou desconectar mexia no aviso de
/// todo mundo, e por isso a tela era do super admin. Agora cada igreja pareia
/// o seu, e a notícia sai pelo número da igreja que a publicou.
///
/// O `id` é a chave que o Baileys usa (`creds`, `pre-key-3`,
/// `session-5511…`), e ela só é única dentro de uma sessão — daí a chave
/// composta. Sem o `churchId` na chave, a credencial de uma igreja
/// sobrescreveria a da outra na primeira gravação.
model WhatsappAuth {
  churchId  String
  id        String
  data      String
  updatedAt DateTime @updatedAt
  church    Church   @relation(fields: [churchId], references: [id], onDelete: Cascade)

  @@id([churchId, id])
  @@index([churchId])
  @@map("whatsapp_auth")
}
