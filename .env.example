# Copie para .env e preencha. O .env nunca entra na imagem (ver .dockerignore):
# os valores são injetados em runtime (--env-file, env do stack, secrets do host).

DATABASE_URL="postgresql://admin:admin@localhost:5433/ic?schema=public"
PORT=5000

# Service account do Firebase (JSON em uma linha)
FIREBASE=

# Envio de e-mail (OAuth2 Google)
USER_CLIENT_SERVER_EMAIL=
CLIENT_ID_SERVER_EMAIL=
CLIENT_SECRET_SERVER_EMAIL=
REFRESH_TOKEN_SERVER_EMAIL=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_ALGORITHM=
JWT_REFRESH_SECRET=
JWT_REFRESH_ISSUER=

# PagBank
TOKEN_API_PAG_BANK=
URL_API_PAG_BANK=

URL_BACKEND=
URL_FRONTEND=

# Basic auth do Swagger (/api) — default do código é admin/!password@
SWAGGER_USERNAME=
SWAGGER_PASSWORD=
