# Copie para .env e preencha. O .env nunca entra na imagem (ver .dockerignore):
# os valores são injetados em runtime (--env-file, env do stack, secrets do host).

DATABASE_URL="postgresql://admin:admin@localhost:5433/ic?schema=public"
PORT=5000

# Service account do Firebase (JSON em uma linha)
FIREBASE=

# Envio de e-mail (OAuth2 Google)
USER_CLIENT_SERVER_EMAIL=
CLIENT_ID_SERVER_EMAIL=
CLIENT_SECRET_SERVER_EMAIL=
REFRESH_TOKEN_SERVER_EMAIL=

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_ALGORITHM=
JWT_REFRESH_SECRET=
JWT_REFRESH_ISSUER=

# Cofre das credenciais de cobrança — OBRIGATÓRIO para pagamento online.
#
# As credenciais dos gateways ficam no banco, cifradas com AES-256-GCM por esta
# chave. Sem ela o sistema sobe, mas nenhuma igreja consegue cadastrar nem usar
# integração de pagamento.
#
# Gere com:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Guarde fora do banco e fora do repositório. Perdê-la é perder as credenciais
# de todas as igrejas — elas terão que ser cadastradas de novo.
PAYMENT_CREDENTIALS_KEY=

# Rotação (opcional): suba a versão, gere uma chave nova acima e mantenha a
# antiga aqui para o que já está gravado continuar legível.
# PAYMENT_CREDENTIALS_KEY_VERSION=2
# PAYMENT_CREDENTIALS_KEY_V1=

# Interruptor geral do pagamento online. Só desligue ("false") quando o
# problema for do sistema: para desligar uma igreja ou um gateway, use a tela
# de Configurações. Ausente = ligado.
# ONLINE_PAYMENT_ENABLED=false

# PagBank, Mercado Pago, InfinitePay e Ton não têm mais variável de ambiente:
# cada igreja cadastra a própria credencial em Configurações › Pagamentos, e
# ela fica cifrada no banco. As duas abaixo ficaram só para o histórico e não
# são lidas por nada.
# TOKEN_API_PAG_BANK=
# URL_API_PAG_BANK=

URL_BACKEND=
URL_FRONTEND=

# Basic auth do Swagger (/api) — default do código é admin/!password@
SWAGGER_USERNAME=
SWAGGER_PASSWORD=
