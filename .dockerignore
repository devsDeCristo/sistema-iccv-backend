# Build context enxuto: menos upload pro daemon e nenhum artefato do host
# vazando pra dentro da imagem.
.git
.gitignore

# node_modules do host é macOS/arm64 — os binários nativos (bcrypt, sharp)
# não servem no Linux. O yarn install do Dockerfile refaz tudo.
node_modules

# dist é recompilado no stage de build
dist
*.tsbuildinfo

# segredos nunca entram na imagem: passe em runtime (--env-file / env do stack)
.env
.env.*
!.env.example

*.log
backup.sql
coverage
.nyc_output
test
.DS_Store
.vscode
.idea

Dockerfile
.dockerignore
docker-compose.yml

# Nenhum .md entra na imagem. Eles não servem em runtime e descrevem a
# estrutura interna do sistema — docs/pagamentos.md, por exemplo, explica o
# recorte por igreja, o cofre de credenciais e as armadilhas conhecidas. Isso é
# material de quem desenvolve, não de quem roda o container.
#
# `**/` não é enfeite: no .dockerignore, `*.md` casa **só a raiz** do contexto.
# Com a regra sem prefixo, README.md ficava de fora e docs/pagamentos.md entrava
# — conferido construindo uma imagem de teste com as duas regras.
**/*.md

# arquivos de deploy: usados no servidor, não dentro da imagem
deploy
